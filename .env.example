# ---- Shopify ----
# Your myshopify domain (no protocol, no trailing slash)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API access token (shpat_...). Server-side only, never expose to a client.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin GraphQL API version. Bump this when you migrate to a newer version.
SHOPIFY_API_VERSION=2026-07

# Optional: public storefront domain used to build product URLs.
# Defaults to https://SHOPIFY_STORE_DOMAIN when unset.
# SHOPIFY_STOREFRONT_URL=https://www.your-store.com

# ---- Server ----
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional: when set, every /api and /connector request must send
#   Authorization: Bearer <CONNECTOR_API_KEY>
# Leave empty/unset to disable auth for local development.
CONNECTOR_API_KEY=

# ---- Rate limiting ----
# Max requests per IP per window, for the endpoints that reach Shopify.
# 0 (the default) disables rate limiting. Set this before exposing the service
# publicly: Shopify's Admin API is cost-based rate limited, so an unthrottled
# caller can exhaust the store's budget and throttle the storefront too.
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_SECONDS=60
